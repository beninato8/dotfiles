{
	"[dart]": {
		"editor.formatOnSave": true,
		"editor.formatOnType": true,
		"editor.rulers": [120],
		"editor.selectionHighlight": false,
		"editor.suggestSelection": "first",
		"editor.tabCompletion": "onlySnippets",
		"editor.wordBasedSuggestions": "off"
	},
	"dart.debugExternalPackageLibraries": true,
	"dart.debugSdkLibraries": false,
	"dart.lineLength": 120,
	"terminal.integrated.fontFamily": "Hack Nerd Font Mono",
	"editor.rulers": [],
	"emmet.preferences": {},
	"dart.devToolsBrowser": "default",
	"dart.flutterSdkPath": "/Users/beninato/fvm/versions/3.32.8",
	"dart.sdkPath": "/Users/beninato/fvm/versions/3.32.8",
	"editor.codeActionsOnSave": {
		"source.fixAll.biome": "always",
		"source.organizeImports.biome": "always",
		"source.biome": "always"
	},
	"aws.telemetry": false,
	"json.schemas": [],
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome",
		"editor.formatOnSave": true,
		"editor.formatOnType": true
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome",
		"editor.formatOnSave": true,
		"editor.formatOnType": true
	},
	"[jsonc]": {
		"editor.defaultFormatter": "biomejs.biome",
		"editor.formatOnSave": true,
		"editor.formatOnType": true
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome",
		"editor.formatOnSave": true,
		"editor.formatOnType": true
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome",
		"editor.formatOnSave": true,
		"editor.formatOnType": true
	},
	"terminal.integrated.scrollback": 100000,
	"cmake.showOptionsMovedNotification": false,
	"protoc": {
		"clang-format.style": "default"
	},
	"[proto3]": {
		"editor.formatOnSave": true
	},
	"dart.showTodos": true,
	"terminal.integrated.env.windows": {
		"DISPLAY": "127.0.0.1:10.0"
	},
	"prettier.trailingComma": "all",
	"cmake.pinnedCommands": [
		"workbench.action.tasks.configureTaskRunner",
		"workbench.action.tasks.runTask"
	],
	"[cpp]": {
		"editor.formatOnSave": true
	},
	"[shellscript]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "mads-hartmann.bash-ide-vscode"
	},
	"git.openRepositoryInParentFolders": "never",
	"bashIde.shfmt.path": "/opt/homebrew/bin/shfmt",
	"prettier.prettierPath": "/opt/homebrew/lib/node_modules/prettier",
	"go.goroot": "/opt/homebrew/opt/go/libexec",
	"diffEditor.renderSideBySide": false,
	"eslint.format.enable": true,
	"bashIde.shellcheckPath": "/opt/homebrew/bin/shellcheck",
	"cmake.ignoreCMakeListsMissing": true,
	"go.toolsManagement.autoUpdate": true,
	"cursor.cpp.disabledLanguages": ["plaintext", "scminput"],
	"workbench.colorTheme": "Default Dark Modern",
	"[starlark]": {
		"editor.defaultFormatter": "BazelBuild.vscode-bazel",
		"editor.formatOnSave": true
	},
	"bazel.buildifierExecutable": "/opt/homebrew/bin/buildifier",
	"cursor.cpp.enablePartialAccepts": true,
	"cursor.composer.shouldChimeAfterChatFinishes": true,
	"extensions.ignoreRecommendations": true,
	"cursor.composer.backspaceRemoveContext": false,
	"prisma.hidePrisma6Prompts": true,
	"gitblame.inlineMessageEnabled": true,
	"gitblame.extendedHoverInformation": "inline-status",
	"biome.lsp.trace.server": "verbose",
	"cursor.composer.usageSummaryDisplay": "always",
	"window.autoDetectColorScheme": false,
	"terminal.integrated.enableMultiLinePasteWarning": "never",
	"workbench.preferredDarkColorTheme": "Default Dark Modern"

}